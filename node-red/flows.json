  {
    "id": "in_temp_proc",
    "type": "function",
    "z": "tab_iot",
    "name": "Format chart: nama ruang + angka",
    "func": "const p = String(msg.topic || '').split('/');\nif (p.length < 4) return null;\nmsg.topic = p[2];\nmsg.payload = Number(msg.payload);\nif (!Number.isFinite(msg.payload)) return null;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 100,
    "wires": [
      [
        "chart_suhu"
      ]
    ]
  },
  {
    "id": "in_hum_proc",
    "type": "function",
    "z": "tab_iot",
    "name": "Routing kelembapan per ruang",
    "func": "const p = String(msg.topic || '').split('/');\nconst i = ['ruang1','ruang2','ruang3','ruang4'].indexOf(p[2]);\nif (i < 0) return null;\nmsg.payload = Number(msg.payload);\nif (!Number.isFinite(msg.payload)) return null;\nreturn [i===0?msg:null, i===1?msg:null, i===2?msg:null, i===3?msg:null];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 300,
    "wires": [
      [
        "gauge_hum1"
      ],
      [
        "gauge_hum2"
      ],
      [
        "gauge_hum3"
      ],
      [
        "gauge_hum4"
      ]
    ]
  },
  {
    "id": "in_status_proc",
    "type": "function",
    "z": "tab_iot",
    "name": "Routing status per ruang",
    "func": "const p = String(msg.topic || '').split('/');\nconst i = ['ruang1','ruang2','ruang3','ruang4'].indexOf(p[2]);\nif (i < 0) return null;\nmsg.payload = String(msg.payload).trim().toLowerCase();\nif (msg.payload !== 'online' && msg.payload !== 'offline') return null;\nreturn [i===0?msg:null, i===1?msg:null, i===2?msg:null, i===3?msg:null];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 460,
    "y": 500,
    "wires": [
      [
        "text_status1"
      ],
      [
        "text_status2"
      ],
      [
        "text_status3"
      ],
      [
        "text_status4"
      ]
    ]
  },
