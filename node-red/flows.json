        "name": "state -> teks status lampu",
        "func": "// topic: pens/klpX/ruangN/lampM/state -> output ke-(N-1)*2+(M-1)\nconst p = msg.topic.split(\"/\");\nconst room = parseInt(p[2].replace(\"ruang\", \"\"));\nconst lamp = parseInt(p[3].replace(\"lamp\", \"\"));\nif (!(room >= 1 && room <= 4 && (lamp === 1 || lamp === 2))) return null;\nconst v = String(msg.payload).trim();\nif (v !== \"1\" && v !== \"0\") return null;\nconst txt = v === \"1\" ? '<font color=\"green\"><b>NYALA</b></font>' : '<font color=\"gray\"><b>MATI</b></font>';\nconst out = new Array(8).fill(null);\nout[(room - 1) * 2 + (lamp - 1)] = { payload: txt };\nreturn out;",
