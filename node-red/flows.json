    {
        "id": "565dcc1854c17734",
        "type": "function",
        "z": "879f9b67e3dfedd9",
        "name": "Siapkan data untuk SQLite",
        "func": "const parts = String(msg.topic || \"\").split(\"/\");\nif (parts.length < 4) return null;\n\nconst room = parts[2];     // contoh: ruang1\nconst metric = parts[3];   // contoh: temperature / humidity\n\nif (![\"temperature\", \"humidity\"].includes(metric)) return null;\n\nconst value = Number(msg.payload);\nif (!Number.isFinite(value)) return null;\n\n// Format tanggal standar SQLite (YYYY-MM-DD HH:MM:SS)\nconst now = new Date().toISOString().slice(0, 19).replace('T', ' 합동 ');\n// Atau gunakan string ISO biasa:\nconst timestamp = new Date().toISOString();\n\n// Gabungkan langsung string SQL-nya ke msg.topic agar aman dari error NOT NULL\nmsg.topic = `INSERT INTO sensor_history (timestamp, room, metric, value) VALUES ('${timestamp}', '${room}', '${metric}', ${value})`;\nmsg.payload = null; // Kosongkan payload karena data sudah masuk ke string SQL\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
